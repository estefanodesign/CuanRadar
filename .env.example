# CuanRadar — environment template
# Salin ke .env.local (frontend) / .env (server-side script) dan isi dari proyek Supabase Anda (Fase 1).

# Supabase (project URL & anon key — client-side, aman dipakai di browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — SERVER-SIDE ONLY (scripts/seed-supabase.mjs, edge functions).
# JANGAN pernah dipakai atau di-commit di frontend (AI_RULES §9).
SUPABASE_SERVICE_ROLE_KEY=
